<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>cn.iocoder.spring-ai-alibaba.compatibility</groupId>
    <artifactId>admin-core-consumer</artifactId>
    <version>1.1.2.2-jdk8-SNAPSHOT</version>
    <properties>
        <java.version>8</java.version>
        <elasticsearch.version>8.19.11</elasticsearch.version>
        <maven.compiler.release>8</maven.compiler.release>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
        <compat.expected.vm>${java.specification.version}</compat.expected.vm>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencyManagement><dependencies>
        <dependency><groupId>cn.iocoder.spring-ai</groupId><artifactId>spring-ai-bom</artifactId><version>2.1.1-jdk8-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
        <dependency><groupId>cn.iocoder.spring-ai-alibaba</groupId><artifactId>spring-ai-alibaba-bom</artifactId><version>1.1.2.2-jdk8-SNAPSHOT</version><type>pom</type><scope>import</scope></dependency>
    </dependencies></dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.spring-ai-alibaba</groupId>
            <artifactId>spring-ai-alibaba-admin-server-core</artifactId>
            <version>1.1.2.2-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration><jvm>${compat.test.jvm}</jvm></configuration>
    </plugin></plugins></build>
</project>
